# ─────────────────────────────────────────────────────────────────
# Smart Camera Analytics System - Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=sca_user
POSTGRES_PASSWORD=sca_secret_change_me
POSTGRES_DB=sca_db

# Backend
SECRET_KEY=change-this-to-a-long-random-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# CV Worker
CV_CAMERA_ID=1
# VIDEO_SOURCE can be:
#   0            → webcam index
#   /videos/test.mp4  → local video file (mount in docker-compose)
#   rtsp://user:pass@192.168.1.100:554/stream1 → RTSP IP camera
VIDEO_SOURCE=0
